# xmake
/build/
/.xmake/

# Release packages built by tools/package.ps1 - fully reproducible from a tag, and the
# map assets alone are 50 MB per package.
/dist/

# Generated by tools/gen_ue4ss_importlib.ps1 (byproduct of lib.exe; not needed to link)
/sdk/lib/UE4SS.exp

# Build artefacts staged into the deploy layout
/deploy/**/*.dll
/deploy/**/*.pdb
/deploy/**/*.exp
/deploy/**/*.lib

# MSVC / editor cruft
*.user
*.suo
*.VC.db
.vs/
.vscode/
*.ilk

# recon dumps (generated at runtime).
# Keep the dumps themselves: they are the recorded evidence behind
# .workspace/wuchang-minimap/context/wuchang-classes.md and cannot be re-taken
# without another in-game session. Everything else in out/ stays ignored.
tools/lua-recon/WuchangRecon/out/*
!tools/lua-recon/WuchangRecon/out/.gitkeep
!tools/lua-recon/WuchangRecon/out/dump_*.txt
!tools/lua-recon/WuchangRecon/out/navprobe_*.csv
!tools/lua-recon/WuchangRecon/out/navprobe_*.png
!tools/lua-recon/WuchangRecon/out/track.csv
!tools/lua-recon/WuchangRecon/out/pickupwatch_*.txt

# Navmesh dumps pulled back from the game with deploy.ps1 -Pull, and renders.
# Same reasoning as the recon dumps: the JSONs are irreplaceable evidence and get
# committed; the rendered PNGs are reproducible from them and do not.
tools/navmesh/out/
__pycache__/

# Offline navmesh extraction (tools/navmesh/offline). The JSON tiles are fully
# reproducible from the game's paks in seconds -- unlike the runtime dumps above,
# they are NOT irreplaceable evidence, so they stay out of the repo (400 MB for the
# whole game). Of the renders, keep only the primary agent's floors, the bounds/
# alignment metadata and the two probe cross-check crops.
tools/navmesh/dumps_offline/
tools/navmesh/out_offline/*
!tools/navmesh/out_offline/Small_floor*.png
!tools/navmesh/out_offline/bounds.json
!tools/navmesh/out_offline/alignment.json
!tools/navmesh/out_offline/_spot1_zslice.png
!tools/navmesh/out_offline/_spot2_zslice.png

# The deploy\ mirror is a copy of what goes into the game; the map assets there are
# byte-identical to maps\ and only exist so the repo shows the installed layout.
/deploy/**/maps/
/deploy/**/markers/

# Everything the MOD ITSELF writes at runtime, next to its own DLL. These appear in the
# repo only when someone launches the game from the deploy\ mirror (or copies a mod
# folder back), but when they do they must never be committed: the collection tracker
# and the waypoint are one player's save state, the rest are diagnostics.
#   wuchang_minimap_found*.txt      collection tracker (per save slot)
#   wuchang_minimap_waypoint*.txt   full-map waypoints (per save slot)
#   wuchang_minimap.log*            the mod log (and its rotated copies)
#   wuchang_minimap_firstrun.txt    first-run marker
#   wuchang_minimap_hookaddr.txt    resolved hook addresses
#   wuchang_minimap_last_stage.txt  crash breadcrumb: how far start-up got
#   wuchang_minimap_watchdog.txt    stall watchdog report
#   wuchang_minimap_recon_*.txt     in-game recon dumps
wuchang_minimap*.txt
wuchang_minimap.log
wuchang_minimap.log.*

# Packaging scratch: tools\package.ps1 -OutDir dist-test (a full 50 MB package tree).
/dist-test/

# Editor / merge leftovers
*.bak
*.orig
*.rej

# tools/markers provenance digest cache: the sha256 of the 63 GB pak set, keyed by
# path + size + mtime. Purely a local speed-up for `provenance.py` (about 45 s of
# disk the first time), and it names one machine's install path, so it never goes
# in. The digests it caches ARE committed - they are in every generated
# markers/*.json.
tools/markers/.provenance-cache.json

# Claude Code task workspace: the session's task system (skills, hooks, the
# task-workspace MCP server) and the task notes it writes. Local working state,
# not part of the mod.
/.claude/
/.workspace/
/.mcp.json
/CLAUDE.md
